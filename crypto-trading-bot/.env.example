# Copy this file to .env and edit values. Never commit your real .env.

# ---- Trading mode -----------------------------------------------------
LIVE_TRADING=false
STARTING_CAPITAL_USD=1000

# ---- Risk management (applies to both strategies) ---------------------
RISK_PER_TRADE_PCT=1.5
MAX_DAILY_LOSS_PCT=6
MAX_DRAWDOWN_PCT=20
MAX_OPEN_POSITIONS=5
MAX_CONCURRENT_PUMPFUN_POSITIONS=3
CONSECUTIVE_LOSSES_TO_COOLDOWN=2
CONSECUTIVE_LOSS_COOLDOWN_HOURS=12

# ---- DexScreener trend-confluence strategy -----------------------------
DEXSCREENER_CHAINS=solana,base,ethereum
MIN_LIQUIDITY_USD=50000
MIN_VOLUME_24H_USD=100000
MIN_PAIR_AGE_HOURS=24
DEX_ENTRY_SCORE_THRESHOLD=70
DEX_EXIT_SCORE_THRESHOLD=40
DEX_POLL_INTERVAL_SECONDS=60
DEX_POSITION_SIZE_USD=200

# ---- pump.fun boom/bust strategy ---------------------------------------
PUMPFUN_MIN_MARKET_CAP_USD=5000
PUMPFUN_MAX_MARKET_CAP_USD=150000
PUMPFUN_MIN_HOLDER_COUNT=25
PUMPFUN_MAX_DEV_HOLD_PCT=15
PUMPFUN_POSITION_SIZE_USD=25
PUMPFUN_ORIGINALITY_MIN_SCORE=65
PUMPFUN_STOP_LOSS_PCT=30
PUMPFUN_MOONBAG_PCT=20
PUMPFUN_POLL_INTERVAL_SECONDS=20

# ---- Wallet / execution (LIVE mode only — leave blank for paper trading)
# NEVER paste a real private key into a shared or AI-assisted environment.
# Use a small, dedicated hot wallet — never your main wallet.
SOLANA_RPC_URL=
WALLET_PRIVATE_KEY=
JUPITER_SLIPPAGE_BPS=150

# ---- Optional alerts -----------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
